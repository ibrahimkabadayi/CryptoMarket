{
  "openapi": "3.0.1",
  "info": {
    "title": "Portfolio.API",
    "version": "v1",
    "description": "User wallets, balance operations, crypto trading, transfers, and limit order matching engine"
  },
  "paths": {
    "/api/wallet": {
      "get": {
        "tags": ["Wallet"],
        "summary": "Get portfolio dashboard overview for authenticated user",
        "operationId": "GetPortfolioDashboard",
        "security": [{ "Bearer": [] }],
        "responses": {
          "200": {
            "description": "Portfolio dashboard data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": { "$ref": "#/components/schemas/PortfolioDashboardDto" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/wallet/deposits": {
      "post": {
        "tags": ["Wallet"],
        "summary": "Deposit fiat balance to user wallet",
        "operationId": "DepositMoney",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DepositMoneyRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Deposit completed successfully" },
          "400": { "description": "Missing Idempotency-Key or invalid amount" },
          "409": { "description": "Duplicate idempotency transaction key" }
        }
      }
    },
    "/api/wallet/withdrawals": {
      "post": {
        "tags": ["Wallet"],
        "summary": "Withdraw fiat balance from user wallet",
        "operationId": "WithdrawMoney",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/WithdrawMoneyRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Withdrawal completed successfully" },
          "400": { "description": "Insufficient balance or invalid amount" },
          "409": { "description": "Duplicate idempotency transaction key" }
        }
      }
    },
    "/api/wallet/assets/{symbol}/purchases": {
      "post": {
        "tags": ["Wallet"],
        "summary": "Buy crypto asset at market price",
        "operationId": "BuyAsset",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BuyAssetRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Purchase executed" },
          "400": { "description": "Insufficient fiat funds" },
          "409": { "description": "Duplicate idempotency transaction key" }
        }
      }
    },
    "/api/wallet/assets/{symbol}/sales": {
      "post": {
        "tags": ["Wallet"],
        "summary": "Sell crypto asset holding",
        "operationId": "SellAsset",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SellAssetRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Sale executed" },
          "400": { "description": "Insufficient asset quantity" },
          "409": { "description": "Duplicate idempotency transaction key" }
        }
      }
    },
    "/api/wallet/assets/{symbol}/transfers": {
      "post": {
        "tags": ["Wallet"],
        "summary": "Transfer crypto asset to another wallet address",
        "operationId": "TransferAsset",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TransferAssetRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Transfer completed" },
          "400": { "description": "Invalid recipient address or insufficient asset quantity" },
          "409": { "description": "Duplicate idempotency transaction key" }
        }
      }
    },
    "/api/limit-orders": {
      "post": {
        "tags": ["LimitOrders"],
        "summary": "Create limit order",
        "operationId": "CreateLimitOrder",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateLimitOrderRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Order submitted" },
          "400": { "description": "Invalid order payload" },
          "401": { "description": "Unauthorized" },
          "409": { "description": "Duplicate idempotency transaction key" }
        }
      },
      "get": {
        "tags": ["LimitOrders"],
        "summary": "Get all limit orders across system",
        "operationId": "GetAllLimitOrders",
        "security": [{ "Bearer": [] }],
        "responses": {
          "200": {
            "description": "List of limit orders",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/LimitOrderDto" }
                }
              }
            }
          }
        }
      }
    },
    "/api/limit-orders/{id}": {
      "get": {
        "tags": ["LimitOrders"],
        "summary": "Get limit order by ID",
        "operationId": "GetLimitOrderById",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Limit order",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LimitOrderDto" }
              }
            }
          },
          "404": { "description": "Order not found" }
        }
      },
      "patch": {
        "tags": ["LimitOrders"],
        "summary": "Update pending limit order target price or amount",
        "operationId": "UpdateLimitOrder",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateLimitOrderRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Order updated" }
        }
      },
      "delete": {
        "tags": ["LimitOrders"],
        "summary": "Cancel (hard-delete) pending limit order",
        "operationId": "DeleteLimitOrder",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": { "description": "Order deleted" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "PortfolioDashboardDto": {
        "type": "object",
        "properties": {
          "walletId": { "type": "string", "format": "uuid" },
          "address": { "type": "string" },
          "fiatBalance": { "type": "number", "format": "decimal" },
          "totalPortfolioValue": { "type": "number", "format": "decimal" },
          "assets": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AssetDto" }
          },
          "recentTransactions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TransactionDto" }
          }
        }
      },
      "AssetDto": {
        "type": "object",
        "properties": {
          "symbol": { "type": "string" },
          "quantity": { "type": "number", "format": "decimal" },
          "costBasis": { "type": "number", "format": "decimal" },
          "currentPrice": { "type": "number", "format": "decimal" },
          "currentTotalValue": { "type": "number", "format": "decimal" }
        }
      },
      "TransactionDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "symbol": { "type": "string" },
          "amount": { "type": "number", "format": "decimal" },
          "price": { "type": "number", "format": "decimal" },
          "transactionType": { "type": "string" },
          "transactionDate": { "type": "string", "format": "date-time" }
        }
      },
      "DepositMoneyRequest": {
        "type": "object",
        "required": ["amount"],
        "properties": {
          "amount": { "type": "number", "format": "decimal" }
        }
      },
      "WithdrawMoneyRequest": {
        "type": "object",
        "required": ["amount"],
        "properties": {
          "amount": { "type": "number", "format": "decimal" }
        }
      },
      "BuyAssetRequest": {
        "type": "object",
        "required": ["amount", "price"],
        "properties": {
          "amount": { "type": "number", "format": "decimal" },
          "price": { "type": "number", "format": "decimal" }
        }
      },
      "SellAssetRequest": {
        "type": "object",
        "required": ["amount", "price"],
        "properties": {
          "amount": { "type": "number", "format": "decimal" },
          "price": { "type": "number", "format": "decimal" }
        }
      },
      "TransferAssetRequest": {
        "type": "object",
        "required": ["receiverWalletAddress", "amount"],
        "properties": {
          "receiverWalletAddress": { "type": "string" },
          "amount": { "type": "number", "format": "decimal" }
        }
      },
      "CreateLimitOrderRequest": {
        "type": "object",
        "required": ["walletId", "symbol", "targetPrice", "amount", "orderType"],
        "properties": {
          "walletId": { "type": "string", "format": "uuid" },
          "symbol": { "type": "string" },
          "targetPrice": { "type": "number", "format": "decimal" },
          "amount": { "type": "number", "format": "decimal" },
          "orderType": { "type": "integer", "description": "1 = Buy, 2 = Sell" }
        }
      },
      "UpdateLimitOrderRequest": {
        "type": "object",
        "properties": {
          "targetPrice": { "type": "number", "format": "decimal" },
          "amount": { "type": "number", "format": "decimal" }
        }
      },
      "LimitOrderDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "walletId": { "type": "string", "format": "uuid" },
          "symbol": { "type": "string" },
          "targetPrice": { "type": "number", "format": "decimal" },
          "amount": { "type": "number", "format": "decimal" },
          "orderType": { "type": "string" },
          "orderStatus": { "type": "string" }
        }
      }
    }
  }
}
