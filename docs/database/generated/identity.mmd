}
class AspNetUsers {
   timestamp with time zone CreatedDate
   timestamp with time zone UpdatedDate
   varchar(50) FirstName
   varchar(50) LastName
   varchar(256) UserName
   varchar(256) NormalizedUserName
   varchar(256) Email
