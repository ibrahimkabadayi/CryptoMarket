# ╔══════════════════════════════════════════════════════════════╗
# ║  CryptoMarket Microservices — Environment Variables         ║
# ║  Copy this file to .env and fill in the values.             ║
# ║  NEVER commit .env to version control.                      ║
# ╚══════════════════════════════════════════════════════════════╝

# ── RabbitMQ ───────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ── JWT (shared across all services, min 32 characters) ───────
# 🔒 SECRET — rotate regularly, store in a vault in production
JWT_SECRET_KEY=ChangeThisToAStrongKeyAtLeast32Characters

# ── Gemini AI (used by Market.API for news generation) ────────
# 🔒 SECRET
AI_KEY=your_gemini_api_key

# ── Email / SMTP (used by Notifications.API) ─────────────────
# 🔒 SECRET — Gmail App Password or equivalent
EMAIL_PASSWORD=your_email_app_password

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=Password123*
# Default database created by the postgres container:
# POSTGRES_DB=IdentityDb  (set inside docker-compose.yml)

# ── Redis (optional — default Alpine image ignores these) ────
REDIS_USERNAME=
REDIS_PASSWORD=

# ── Docker Registry (optional, used by CI/CD image tags) ─────
DOCKER_REGISTRY=
